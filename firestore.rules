rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function owns(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function doctorAt(facilityId) {
      return request.auth != null
        && request.auth.token.role == 'doctor'
        && request.auth.token.facilityId == facilityId;
    }

    match /users/{userId} {
      allow get: if owns(userId);
      allow create: if owns(userId)
        && !request.resource.data.keys().hasAny([
          'role',
          'facilityId',
          'facilityName',
          'doctorName'
        ]);
      allow update: if owns(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role',
          'facilityId',
          'facilityName',
          'doctorName'
        ]);
      allow list, delete: if false;

      match /alerts/{alertId} {
        allow read: if owns(userId);
        allow create: if owns(userId)
          && request.resource.data.keys().hasOnly([
            'type',
            'situation',
            'reason',
            'location',
            'status',
            'latitude',
            'longitude',
            'createdAt'
          ])
          && request.resource.data.type == 'Critical'
          && request.resource.data.status == 'prepared'
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /passport/{passportId} {
        allow get: if owns(userId) && passportId == 'current';
        allow list: if false;
        allow create, update: if owns(userId)
          && passportId == 'current'
          && request.resource.data.keys().hasOnly([
            'schemaVersion',
            'bloodGroup',
            'heightCm',
            'weightKg',
            'allergies',
            'conditions',
            'medications',
            'emergencyContactName',
            'emergencyContactPhone',
            'emergencyContactRelationship',
            'preferredHospital',
            'qrConsentName',
            'qrConsentBlood',
            'qrConsentHeight',
            'qrConsentWeight',
            'qrConsentAllergies',
            'qrConsentConditions',
            'qrConsentEmergencyContact',
            'qrConsentMedications',
            'qrConsentPreferredHospital',
            'updatedAt'
          ])
          && request.resource.data.schemaVersion == 1
          && request.resource.data.bloodGroup is string
          && request.resource.data.bloodGroup.size() <= 8
          && request.resource.data.heightCm is string
          && request.resource.data.heightCm.size() <= 12
          && request.resource.data.weightKg is string
          && request.resource.data.weightKg.size() <= 12
          && request.resource.data.allergies is string
          && request.resource.data.allergies.size() <= 1000
          && request.resource.data.conditions is string
          && request.resource.data.conditions.size() <= 1000
          && request.resource.data.medications is string
          && request.resource.data.medications.size() <= 2000
          && request.resource.data.emergencyContactName is string
          && request.resource.data.emergencyContactName.size() <= 100
          && request.resource.data.emergencyContactPhone is string
          && request.resource.data.emergencyContactPhone.size() <= 32
          && request.resource.data.emergencyContactRelationship is string
          && request.resource.data.emergencyContactRelationship.size() <= 60
          && request.resource.data.preferredHospital is string
          && request.resource.data.preferredHospital.size() <= 160
          && request.resource.data.qrConsentName is bool
          && request.resource.data.qrConsentBlood is bool
          && request.resource.data.qrConsentHeight is bool
          && request.resource.data.qrConsentWeight is bool
          && request.resource.data.qrConsentAllergies is bool
          && request.resource.data.qrConsentConditions is bool
          && request.resource.data.qrConsentEmergencyContact is bool
          && request.resource.data.qrConsentMedications is bool
          && request.resource.data.qrConsentPreferredHospital is bool
          && request.resource.data.updatedAt == request.time;
        allow delete: if owns(userId) && passportId == 'current';
      }

      match /appointments/{appointmentId} {
        allow read: if owns(userId);
        allow create: if owns(userId)
          && request.resource.data.patientUid == userId
          && request.resource.data.status == 'requested';
        allow update: if owns(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'cancelledAt', 'updatedAt'])
          && request.resource.data.status == 'cancelled';
        allow delete: if false;
      }

      match /labBookings/{bookingId} {
        allow read, create: if owns(userId);
        allow update, delete: if false;
      }

      match /reminders/{reminderId} {
        allow read: if owns(userId);
        allow create: if owns(userId)
          && request.resource.data.keys().hasOnly([
            'title',
            'details',
            'reminderAt',
            'status',
            'createdAt'
          ])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.details is string
          && request.resource.data.details.size() <= 500
          && request.resource.data.reminderAt is timestamp
          && request.resource.data.status == 'scheduled'
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /labResults/{resultId} {
        allow read: if owns(userId);
        allow write: if false;
      }

      match /aiSummaryConsents/{resultId} {
        allow read: if owns(userId);
        allow create: if owns(userId)
          && request.resource.data.keys().hasOnly([
            'accepted',
            'version',
            'createdAt'
          ])
          && request.resource.data.accepted == true
          && request.resource.data.version == '2026-01'
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /appointments/{appointmentId} {
      allow read: if owns(resource.data.patientUid)
        || doctorAt(resource.data.facilityId);
      allow create: if request.auth != null
        && request.resource.data.patientUid == request.auth.uid
        && request.resource.data.status == 'requested'
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          'patientUid',
          'patient',
          'memberId',
          'memberName',
          'mode',
          'doctor',
          'specialty',
          'date',
          'slot',
          'reason',
          'area',
          'availabilityId',
          'facilityId',
          'hospitalId',
          'hospitalName',
          'hospitalAddress',
          'hospitalLatitude',
          'hospitalLongitude',
          'status',
          'createdAt'
        ])
        && (request.resource.data.mode != 'In-person'
          || (request.resource.data.facilityId is string
            && request.resource.data.facilityId == request.resource.data.hospitalId
            && request.resource.data.hospitalName is string));
      allow update, delete: if false;
    }

    match /facilities/{facilityId}/availability/{slotId} {
      allow read: if true;
      allow create: if doctorAt(facilityId)
        && request.resource.data.facilityId == facilityId
        && request.resource.data.status == 'available'
        && request.resource.data.date is string
        && request.resource.data.slot is string;
      allow update, delete: if doctorAt(facilityId);
    }
  }
}
